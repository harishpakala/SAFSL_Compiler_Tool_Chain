<?xml version='1.0' encoding='utf-8'?>
<FBType name="q3">
  <InterfaceList>
    <EventInputs>
      <Event name="EP3"/>
    </EventInputs>
    <EventOutputs>
      <Event name="EP4"/>
      <Event name="EP5"/>
    </EventOutputs>
    <InputVars>
      <VarDeclaration name="LS" type="REAL" Value="0" Address="Empty"/>
      <VarDeclaration name="pH" type="REAL" Value="0" Address="Empty"/>
      <VarDeclaration name="LS3" type="REAL" Value="0.9"/>
      <VarDeclaration name="pHMin" type="REAL" Value="6.5"/>
      <VarDeclaration name="pHMax" type="REAL" Value="7.5"/>
    </InputVars>
    <OutputVars>
      <VarDeclaration name="va1" type="BOOL" Value="TRUE" Address="Empty"/>
      <VarDeclaration name="va2" type="BOOL" Value="TRUE" Address="Empty"/>
      <VarDeclaration name="va3" type="BOOL" Value="TRUE" Address="Empty"/>
      <VarDeclaration name="va4" type="BOOL" Value="TRUE" Address="Empty"/>
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <InternalVars/>
    <Algorithm Name="ALG" Type="ST"><![CDATA[va1 := FALSE;
va2 := FALSE;
va3 := FALSE;
va4 := FALSE;
va1 := TRUE;
va2 := FALSE;
va3 := FALSE;
va4 := FALSE;
va1 := FALSE;
va2 := TRUE;
va3 := FALSE;
va4 := FALSE;
IF (LS >= LS3) THEN
va2 := FALSE;
va4 := TRUE;
END_IF;
IF ((pH >= pHMin) AND (pH <= pHMax)) THEN
va1 := FALSE;
va2 := FALSE;
va3 := TRUE;
END_IF;]]></Algorithm>
  </BasicFB>
  <ECC>
    <ECState name="START" Initial="true"/>
    <ECState name="BODY">
      <ECAction Algorithm="ALG"/>
    </ECState>
    <ECTransition Source="START" Destination="BODY">
      <ECEventCondition Event="EP3"/>
    </ECTransition>
    <ECTransition Source="BODY" Destination="EP4_STATE">
      <ECCondition>(LS &gt;= LS3)</ECCondition>
    </ECTransition>
    <ECState Name="EP4_STATE">
      <ECAction Output="EP4"/>
    </ECState>
    <ECTransition Source="BODY" Destination="EP5_STATE">
      <ECCondition>((pH &gt;= pHMin) AND (pH &lt;= pHMax))</ECCondition>
    </ECTransition>
    <ECState Name="EP5_STATE">
      <ECAction Output="EP5"/>
    </ECState>
  </ECC>
</FBType>
