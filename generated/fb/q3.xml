<?xml version='1.0' encoding='utf-8'?>
<FBType name="q3">
  <InterfaceList>
    <EventInputs>
      <Event name="EP4"/>
    </EventInputs>
    <EventOutputs>
      <Event name="EP5"/>
      <Event name="EP6"/>
    </EventOutputs>
    <InputVars>
      <VarDeclaration name="LS" type="REAL" Value="0" Address="Empty"/>
      <VarDeclaration name="pH" type="REAL" Value="0" Address="Empty"/>
      <VarDeclaration name="ls2" type="REAL" Value="0.6"/>
      <VarDeclaration name="ls3" type="REAL" Value="0.9"/>
      <VarDeclaration name="phMin" type="REAL" Value="6.5"/>
      <VarDeclaration name="phMax" type="REAL" Value="7.5"/>
    </InputVars>
    <OutputVars>
      <VarDeclaration name="va1" type="BOOL" Value="TRUE" Address="Empty"/>
      <VarDeclaration name="va2" type="BOOL" Value="TRUE" Address="Empty"/>
      <VarDeclaration name="va3" type="BOOL" Value="TRUE" Address="Empty"/>
      <VarDeclaration name="va4" type="BOOL" Value="TRUE" Address="Empty"/>
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <InternalVars/>
    <Algorithm Name="ALG" Type="ST"><![CDATA[IF (LS >= ls3) THEN
va2 := FALSE;
va4 := TRUE;
END_IF;
IF ((pH >= phMin) AND (pH <= phMax)) THEN
va2 := FALSE;
va1 := FALSE;
va3 := TRUE;
END_IF;]]></Algorithm>
  </BasicFB>
  <ECC>
    <ECState name="START" Initial="true"/>
    <ECState name="BODY">
      <ECAction Algorithm="ALG"/>
    </ECState>
    <ECTransition Source="START" Destination="BODY">
      <ECEventCondition Event="EP4"/>
    </ECTransition>
    <ECTransition Source="BODY" Destination="EP5_STATE">
      <ECCondition>((LS &lt;= ls2) OR (LS &gt;= LS3))</ECCondition>
    </ECTransition>
    <ECState Name="EP5_STATE">
      <ECAction Output="EP5"/>
    </ECState>
    <ECTransition Source="BODY" Destination="EP6_STATE">
      <ECCondition>NOT (((pH &lt; pHMin) OR (pH &gt; pHMax)))</ECCondition>
    </ECTransition>
    <ECState Name="EP6_STATE">
      <ECAction Output="EP6"/>
    </ECState>
  </ECC>
</FBType>
