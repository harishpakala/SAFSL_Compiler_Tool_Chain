<?xml version='1.0' encoding='utf-8'?>
<FBType name="q3">
  <InterfaceList>
    <EventInputs>
      <Event name="EP4"/>
    </EventInputs>
    <EventOutputs>
      <Event name="EP5"/>
      <Event name="EP6"/>
    </EventOutputs>
    <InputVars>
      <VarDeclaration name="LS1" type="REAL" Value="0.2"/>
      <VarDeclaration name="LS2" type="REAL" Value="0.6"/>
      <VarDeclaration name="LS3" type="REAL" Value="0.9"/>
      <VarDeclaration name="pHMin" type="REAL" Value="0.2"/>
      <VarDeclaration name="pHMax" type="REAL" Value="0.6"/>
    </InputVars>
    <OutputVars>
      <VarDeclaration name="VA2" type="REAL" Value="0.0" Address="Empty"/>
      <VarDeclaration name="VA3" type="REAL" Value="0.0" Address="Empty"/>
      <VarDeclaration name="VA4" type="REAL" Value="0.0" Address="Empty"/>
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <InternalVars>
      <VarDeclaration name="p1" type="STRING" initialvalue="2"/>
      <VarDeclaration name="p2" type="STRING" initialvalue="10"/>
    </InternalVars>
    <Algorithm Name="ALG" Type="ST"><![CDATA[p2 := (p1 + p2);
p1 := (p1 * p2);
p1 := (p1 / p2);
p1 := (p1 - p2);
IF (LS >= LS3 OR LS <= LS1) THEN
VA4 := TRUE;
VA2 := FALSE;
END_IF;
IF NOT ((pH < pHMin OR pH > pHMax)) THEN
VA3 := TRUE;
VA2 := FALSE;
END_IF;]]></Algorithm>
  </BasicFB>
  <ECC>
    <ECState name="START" Initial="true"/>
    <ECState name="BODY">
      <ECAction Algorithm="ALG"/>
    </ECState>
    <ECTransition Source="START" Destination="BODY">
      <ECEventCondition Event="EP4"/>
    </ECTransition>
    <ECTransition Source="BODY" Destination="EP5_STATE">
      <ECCondition>(LS &lt;= LS2 OR LS &gt;= LS3)</ECCondition>
    </ECTransition>
    <ECState Name="EP5_STATE">
      <ECAction Output="EP5"/>
    </ECState>
    <ECTransition Source="BODY" Destination="EP6_STATE">
      <ECCondition>NOT ((pH &lt; pHMin OR pH &gt; pHMax))</ECCondition>
    </ECTransition>
    <ECState Name="EP6_STATE">
      <ECAction Output="EP6"/>
    </ECState>
  </ECC>
</FBType>
