<?xml version='1.0' encoding='utf-8'?>
<FunctionBlock name="fb">
  <InterfaceList>
    <EventInputs>
      <Event name="EP4"/>
    </EventInputs>
    <EventOutputs>
      <Event name="EP5"/>
    </EventOutputs>
    <InputVars>
      <VarDeclaration name="LS1" type="REAL" Value="0.2"/>
      <VarDeclaration name="LS2" type="REAL" Value="0.6"/>
      <VarDeclaration name="LS3" type="REAL" Value="0.9"/>
      <VarDeclaration name="pHMin" type="REAL" Value="0.2"/>
      <VarDeclaration name="pHMax" type="REAL" Value="0.6"/>
    </InputVars>
    <OutputVars/>
  </InterfaceList>
  <BasicFB>
    <Algorithm Name="ALG" Type="ST"><![CDATA[IF (LS >= LS3 OR LS <= LS1) THEN
VA2 := FALSE;
END_IF;
IF NOT ((pH < pHMin OR pH > pHMax)) THEN
VA2 := FALSE;
END_IF;]]></Algorithm>
  </BasicFB>
  <ECC>
    <ECState name="START" Initial="true"/>
    <ECState name="BODY">
      <ECAction Algorithm="ALG"/>
    </ECState>
    <ECTransition Source="START" Destination="BODY">
      <ECEventCondition Event="EP4"/>
    </ECTransition>
    <ECTransition Source="BODY" Destination="EP5_STATE"/>
    <ECState Name="EP5_STATE">
      <ECAction Output="EP5"/>
    </ECState>
  </ECC>
</FunctionBlock>
