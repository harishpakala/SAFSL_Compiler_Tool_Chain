Specification CSTR {
StartTerminal =[q0];
Repository="example.com";
Ref Submodel DEXPI="Q1NUUlByb3A=";
Ref Submodel CPrp="Q1NUUlByb3A=";
Ref SMC VA1 = DEXPI.ActuatingFunctions.VA_CV_001;
Ref SMC VA2 = DEXPI.ActuatingFunctions.VA_CV_002;
Ref SMC VA3 = DEXPI.ActuatingFunctions.VA_CV_003;
Ref SMC VA4 = DEXPI.ActuatingFunctions.VA_CV_004;
Ref SMC LI = DEXPI.InstrumentationFunctions.LI_01;
Ref SMC AT = DEXPI.InstrumentationFunctions.AT_01;
Ref Property LS1=CPrp.LS1; 
Ref Property LS2=CPrp.LS2;
Ref Property LS3=CPrp.LS3;
Ref Property pHMin=CPrp.pHMin;
Ref Property pHMax=CPrp.pHMax;
Ref Property StartCmd=CPrp.Start;



Process q3 {

    Interface {
        Terminal Input EP4;
        Terminal Output EP5;
        Terminal Output EP6;
        Port Input LS = LI;
		Port Input pH = AT;

        Port Input ls2 = LS2;
        Port Input ls3 = LS3;                
		Port Input phMin = pHMin;
		Port Input phMax = pHMax;
		
		Port Output va1 = VA1;
		Port Output va2 = VA2;
		Port Output va3 = VA3;
		Port Output va4 = VA4;

		Predicate P4 -> EP5 {
			orS(lessES(LS, ls2), 
		greatES(LS, LS3))
			}
		Predicate P5 -> EP6 {
		notS(orS(lessS(pH, pHMin), greatS(pH, pHMax)))
		}
    }


    Body {
			IF (greatES(LS,ls3)) 
			THEN
				assign(va2,False);
				assign(va4,True);
			END_IF;
			IF  (andS( greatES( pH, phMin ), lessES(pH, phMax)))
			THEN
				assign(va2,False);
				assign(va1,False);
				assign(va3,True);
			END_IF;
    }

}
}