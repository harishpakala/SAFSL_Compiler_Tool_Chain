Specification CSTR {

Ref Submodel DEXPI="Q1NUUlByb3A=";
Ref Submodel CPrp="Q1NUUlByb3A=";
Ref SMC VA2 = DEXPI.ActuatingFunctions.VA_CV_002;
Ref SMC VA3 = DEXPI.ActuatingFunctions.VA_CV_003;
Ref SMC VA4 = DEXPI.ActuatingFunctions.VA_CV_004;
Ref SMC LI = DEXPI.InstrumentationFunctions.LI_01;
Ref SMC AT = DEXPI.InstrumentationFunctions.AT_01;
Ref Property LS1=CPrp.LS1; 
Ref Property LS2=CPrp.LS2;
Ref Property LS3=CPrp.LS3;
Ref Property pHMin=CPrp.pHMin;
Ref Property pHMax=CPrp.pHMax;
Ref Property StartCmd=CPrp.Start;



Process q3 {

    Interface {
        Terminal Input EP4;
        Terminal Output EP5;
        Terminal Output EP6;
        Port Input LS = LI;
		Port Input pH = AT;

        Port Input LS1 = LS1;
        Port Input LS2 = LS2;
        Port Input LS3 = LS3;                
		Port Input pH = pHMin;
		Port Input pH = pHMax;
		

		Port Output VA2 = VA2;
		Port Output VA3 = VA3;
		Port Output VA4 = VA4;

		Predicate P4 -> EP5 {
			orS(lessES(LS, LS2), 
		greatES(LS, LS3))
			}
		Predicate P5 -> EP6 {
		notS(orS(lessS(pH, pHMin), greatS(pH, pHMax)))
		}
		Property p1 = new Property("xs:decimal","QUDT:K","2");
		Property p2 = new Property("xs:decimal","QUDT:K","10");
    }


    Body {
    		assign(p2,add(p1,p2));
    		assign(p1,mul(p1,p2));
    		assign(p1,div(p1,p2));
    		assign(p1,sub(p1,p2));
            IF (orS(greatES(LS, LS3),lessES(LS,LS1)))
            THEN
				assignS(VA4,True);
                assignS(VA2,False);

            END_IF;
			IF (notS(orS(lessS(pH,pHMin), greatS(pH,pHMax))))
            THEN
				assignS(VA3,True);
                assignS(VA2,False);
            END_IF;
    }

}
}