    Process q3 {

        Interface {

            Terminal Input EP4;

            Terminal Output EP5;

            Port Input LS;

            Predicate P1 -> EP5 {

                greatES(LS,LS3);

            }

        }


        Body {

            IF(greatES(LS,LS3))
            THEN

                VA2.assignS(False);

            END_IF;

        }

    }
